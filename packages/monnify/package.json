{
  "name": "@pay-normalize/monnify",
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "pay-normalize-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "monnify",
    "monnify-webhook",
    "monnify-api",
    "pay-normalize",
    "payments",
    "payment-webhook",
    "webhook",
    "webhook-verification",
    "hmac",
    "signature-verification",
    "disbursement",
    "settlement",
    "fintech",
    "nigeria",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "description": "Monnify connector for pay-normalize: webhooks (collection, disbursement, settlement) and transaction-status API (EXPERIMENTAL).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lordisrael1/pay-normalize.git",
    "directory": "packages/monnify"
  },
  "bugs": "https://github.com/lordisrael1/pay-normalize/issues",
  "homepage": "https://github.com/lordisrael1/pay-normalize/tree/main/packages/monnify#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@pay-normalize/core": "0.1.2",
    "zod": "4.4.3"
  }
}
